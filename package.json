{
  "name": "flash-sale-system",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=12.0.0 <13.0.0"
  },
  "scripts": {
    "lint": "biome check . && node scripts/verify-agent-limits.mjs",
    "format": "biome format --write .",
    "test": "pnpm -r test",
    "test:scripts": "node --test scripts/*.test.mjs",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "typescript": "6.0.3"
  }
}

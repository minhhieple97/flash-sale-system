{
  "name": "flash-sale-system",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=12.0.0 <13.0.0"
  },
  "scripts": {
    "lint": "biome check --error-on-warnings . && node scripts/verify-agent-limits.mjs",
    "format": "biome format --write .",
    "test": "pnpm -r test",
    "test:scripts": "node --test scripts/*.test.mjs",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "verify": "bash .claude/skills/verify/bin/gate.sh",
    "stress:node": "node tests/stress/node-stress-runner.mjs",
    "stress:k6:oversell": "docker compose run --rm --no-deps k6 run /scripts/oversell-stress.k6.js",
    "stress:k6:same-user": "docker compose run --rm --no-deps k6 run /scripts/same-user-race.k6.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "typescript": "6.0.3"
  }
}

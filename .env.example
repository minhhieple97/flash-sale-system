# Copy to .env. Docker Compose reads it for interpolation; the API reads it when run on the host.
NODE_ENV=development
LOG_LEVEL=info

# API listen port on the host, also the published port of the api container.
PORT=3000
# Published port of the web container (nginx).
WEB_PORT=8080

POSTGRES_USER=flash_sale
POSTGRES_PASSWORD=flash_sale
POSTGRES_DB=flash_sale
POSTGRES_HOST=localhost
# Published port of the postgres container; the host-run API connects to it.
POSTGRES_PORT=5432

REDIS_HOST=localhost
# Published port of the redis container; the host-run API connects to it.
REDIS_PORT=6379

# Process role: all (combined API + worker), api (HTTP only), or worker (queue consumer + ledger maintenance).
APP_ROLE=all

ENABLE_ADMIN_ENDPOINTS=true
# Optional shared secret for POST /api/v1/admin/flash-sales/reset (sent via x-admin-key header).
# Left unset by default; set a strong secret when exposing admin endpoints beyond localhost.
ADMIN_API_KEY=

# Set to true only behind a trusted reverse proxy (such as nginx) that sets X-Forwarded-For.
TRUST_PROXY=false

# Optional in-memory per-IP rate limiting on checkout and order-status routes (off by default).
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Sale window and stock. All optional; the API refuses to boot on an invalid value.
# SALE_STARTS_AT and SALE_ENDS_AT go together (set both or neither) and are RFC 3339 timestamps with
# Z or an explicit offset, e.g. 2030-01-01T09:00:00Z or 2030-01-01T09:00:00+07:00. SALE_TOTAL_STOCK is
# an integer from 1 to 1000000.
# Unset: the first boot seeds now, now + 24 h and 100 units, and later boots never move the stored sale.
# Set: a restart rewrites the parts you set (the window, the stock) only while the stored sale has no
# order and no reservation, and keeps the stored value of every part you left unset; otherwise it keeps
# the stored sale and logs a warning.
# SALE_STARTS_AT=
# SALE_ENDS_AT=
# SALE_TOTAL_STOCK=
